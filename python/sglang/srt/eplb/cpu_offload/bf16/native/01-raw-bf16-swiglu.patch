+// 原始 BF16 张量入口，不经过 FP8 反量化或 INT8 权重量化。
+at::Tensor fused_experts_bf16_cpu(
+    at::Tensor& hidden_states, at::Tensor& w1, at::Tensor& w2,
+    at::Tensor& topk_weights, at::Tensor& topk_ids, double swiglu_limit,
+    bool is_vnni) {
+  TORCH_CHECK(!std::isnan(swiglu_limit) && swiglu_limit > 0, "SwiGLU 限值必须为正数");
+  for (const auto& tensor : {hidden_states, w1, w2}) {
+    TORCH_CHECK(tensor.device().is_cpu() && tensor.scalar_type() == at::kBFloat16,
+                "原始 BF16 入口要求 CPU BF16 输入和权重");
+    TORCH_CHECK(tensor.is_contiguous(), "原始 BF16 输入和权重必须连续");
+  }
+  TORCH_CHECK(topk_ids.device().is_cpu() && topk_weights.device().is_cpu(),
+              "路由张量必须在 CPU 上");
+  TORCH_CHECK(topk_ids.is_contiguous() && topk_weights.is_contiguous(), "路由张量必须连续");
+  TORCH_CHECK(hidden_states.dim() == 2 && w1.dim() == 3 && w2.dim() == 3 &&
+              topk_ids.dim() == 2 && topk_weights.dim() == 2, "BF16 专家张量维数错误");
+  TORCH_CHECK(topk_ids.scalar_type() == at::kInt, "专家编号必须使用 int32");
+  TORCH_CHECK(topk_ids.sizes() == topk_weights.sizes() &&
+              topk_ids.size(0) == hidden_states.size(0) && topk_ids.size(1) > 0,
+              "路由形状必须与输入 token 数一致");
+  TORCH_CHECK(w1.size(0) > 0 && w2.size(0) == w1.size(0) &&
+              w1.size(1) == 2 * w2.size(2) && w1.size(2) == hidden_states.size(1) &&
+              w2.size(1) == hidden_states.size(1), "BF16 专家权重形状错误");
+  TORCH_CHECK(hidden_states.size(1) > 0 && w2.size(2) > 0 &&
+              hidden_states.size(1) % block_size_n() == 0 && w2.size(2) % block_size_n() == 0,
+              "BF16 专家维度必须是计算分块的整数倍");
+  TORCH_CHECK(topk_ids.numel() == 0 ||
+              ((topk_ids >= -1) & (topk_ids < w1.size(0))).all().item<bool>(),
+              "专家编号必须为 -1 或合法的局部权重下标");
+  if (hidden_states.size(0) == 0) return at::empty_like(hidden_states);
+  return fused_experts_cpu_impl(hidden_states, w1, w2, topk_weights, topk_ids,
+      false, false, false, std::nullopt, std::nullopt, std::nullopt,
+      std::nullopt, std::nullopt, is_vnni, static_cast<float>(swiglu_limit));
+}
