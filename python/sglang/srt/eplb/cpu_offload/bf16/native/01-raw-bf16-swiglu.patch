diff --git a/ext/bf16_weight_loader.h b/ext/bf16_weight_loader.h
new file mode 100644
index 0000000..9343543
--- /dev/null
+++ b/ext/bf16_weight_loader.h
@@ -0,0 +1,60 @@
+// 由 cpu_expertd.cpp 引入；复用正式槽位，独立验证原始 BF16 权重协议。
+static std::shared_ptr<LayerSlot> load_bf16_layer(cpu_offload::SlotHandle& slot) {
+    auto* p = slot.hdr->req_params;
+    const int layer = (int32_t)p[0], e = (int32_t)p[1], k = (int32_t)p[2];
+    const int h = (int32_t)p[3], i = (int32_t)p[4];
+    TORCH_CHECK(layer >= 0 && e > 0 && e <= 65536 && k > 0 && k <= e &&
+                h > 0 && h <= 65536 && i > 0 && i <= 65536 && h % 32 == 0 && i % 32 == 0,
+                "BF16 层尺寸非法");
+    TORCH_CHECK(p[6] == (uint64_t(1) << 32), "BF16 仅支持 TP=1、rank=0");
+    uint32_t bits = (uint32_t)p[7];
+    TORCH_CHECK(p[5] == 0 && p[7] == bits, "BF16 请求保留字段非法");
+    float limit;
+    std::memcpy(&limit, &bits, sizeof(limit));
+    TORCH_CHECK(std::isfinite(limit) && limit > 0, "BF16 限幅必须为有限正数");
+    std::lock_guard<std::mutex> lk(g_layers_mu);
+    std::lock_guard<std::mutex> build_lk(g_build_mu);
+    TORCH_CHECK(!g_layers.count(layer) && !g_build_pending.count(layer),
+                "BF16 层编号已占用，禁止复用不明权重");
+    const std::string path = slot.path + ".layer" + std::to_string(layer) + ".weights";
+    int fd = ::open(path.c_str(), O_RDONLY);
+    TORCH_CHECK(fd >= 0, "无法打开 BF16 权重文件");
+    void* base = MAP_FAILED;
+    size_t bytes = 0;
+    try {
+        struct stat st;
+        TORCH_CHECK(::fstat(fd, &st) == 0 && st.st_size >= (off_t)sizeof(WeightFileHeader),
+                    "BF16 权重文件过短");
+        bytes = st.st_size;
+        base = ::mmap(nullptr, bytes, PROT_READ, MAP_SHARED, fd, 0);
+        TORCH_CHECK(base != MAP_FAILED, "BF16 权重映射失败");
+        auto* w = (WeightFileHeader*)base;
+        const uint64_t down = uint64_t(e) * h * i * 2;
+        TORCH_CHECK(w->magic == WEIGHT_MAGIC && w->version == 2 &&
+                    w->layer_id == layer && w->expert_num == e &&
+                    w->num_experts_per_tok == k && w->hidden_size == h &&
+                    w->intermediate_size == i && w->norm_topk_prob == 0 &&
+                    w->n_group == 1 && w->topk_group == 1 && w->tp_size == 1 && w->tp_rank == 0 &&
+                    (uint32_t)w->pad0 == bits && w->payload_offset == 4096 &&
+                    w->gate_up_size == down * 2 && w->down_size == down &&
+                    w->gate_up_scale_size == 0 && w->down_scale_size == 0 &&
+                    w->gating_bias_size == 0 && bytes == 4096 + down * 3,
+                    "BF16 权重格式、请求或文件长度不匹配");
+        MOEConfig cfg(layer, e, k, h, i, false, 1, 1);
+        cfg.raw_bf16 = true;
+        cfg.swiglu_limit = limit;
+        auto moe = std::make_unique<MOE>(cfg);
+        moe->setWeights((intptr_t)((char*)base + 4096),
+                        (intptr_t)((char*)base + 4096 + down * 2), 0, 0, 0, 1, 0);
+        auto state = std::make_shared<LayerSlot>();
+        state->moe = moe.release();
+        g_layers.emplace(layer, state);
+        ::munmap(base, bytes);
+        ::close(fd);
+        return state;
+    } catch (...) {
+        if (base != MAP_FAILED) ::munmap(base, bytes);
+        ::close(fd);
+        throw;
+    }
+}
