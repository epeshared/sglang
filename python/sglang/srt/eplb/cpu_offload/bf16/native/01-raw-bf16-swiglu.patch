index 0000000..ed9b3f1
--- /dev/null
+++ b/tests/test_bf16_daemon.py
@@ -0,0 +1,136 @@
+"""连接专用守护进程，验证限幅、错误拒绝和旧 FP8 入口；不启动服务。"""
+
+import ctypes
+import os
+from pathlib import Path
+import struct
+import unittest
+
+import torch
+import moe_cpu_engine as engine
+from cpu_offload_remote_moe import RemoteMOE, _WEIGHT_HDR_FMT, _WEIGHT_MAGIC
+
+
+class DaemonTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.prefix = os.environ["HY4_TEST_SHM_PREFIX"]
+        cls.handle = engine.cpu_client_open_slot(cls.prefix, 0, 0, 10000)
+        if not cls.handle:
+            raise RuntimeError("测试守护进程不可达")
+        torch.set_num_threads(4)
+
+    @classmethod
+    def tearDownClass(cls):
+        engine.cpu_client_close_slot(cls.handle)
+
+    def remote(self, layer):
+        return RemoteMOE(
+            self.handle,
+            layer,
+            2,
+            1,
+            128,
+            128,
+            norm_topk_prob=False,
+            shm_prefix=self.prefix,
+        )
+
+    def forward(self, remote, hidden):
+        ids = torch.zeros(len(hidden), 1, dtype=torch.int32)
+        routing = torch.ones(len(hidden), 1)
+        output = torch.full_like(hidden, float("nan"))
+        before = engine.cpu_client_slot_info(self.handle)
+        fn, arg = remote.forward_experts(
+            hidden.data_ptr(),
+            ids.data_ptr(),
+            routing.data_ptr(),
+            output.data_ptr(),
+            len(hidden),
+        )
+        ctypes.CFUNCTYPE(None, ctypes.c_void_p)(fn)(arg)
+        after = engine.cpu_client_slot_info(self.handle)
+        self.assertEqual(after["error_code"], 0)
+        self.assertEqual(after["req_seq"], after["done_seq"])
+        self.assertEqual(after["stat_fwd_count"], before["stat_fwd_count"] + 1)
+        return output
+
+    def test_raw_clamp_and_duplicate_rejected(self):
+        eye = torch.eye(128, dtype=torch.bfloat16)
+        gate = torch.cat((eye, -eye)).repeat(2, 1, 1)
+        down = eye.repeat(2, 1, 1)
+        remote = self.remote(101)
+        remote.set_bf16_weights(gate, down, 10.0)
+        for tokens in (1, 32):
+            hidden = torch.tensor(
+                [-20.0, -2.0, 2.0, 20.0], dtype=torch.bfloat16
+            ).repeat(tokens, 32)
+            actual = self.forward(remote, hidden)
+            expected = (
+                torch.nn.functional.silu(hidden.float().clamp(max=10))
+                * (-hidden.float()).clamp(-10, 10)
+            ).to(torch.bfloat16)
+            torch.testing.assert_close(actual, expected, rtol=0.008, atol=1e-7)
+        with self.assertRaisesRegex(RuntimeError, "加载失败"):
+            self.remote(101).set_bf16_weights(gate, down, 10.0)
+
+    def test_invalid_file_rejected(self):
+        path = Path(self.prefix + ".socket0.slot0.layer102.weights")
+        bits = struct.unpack("<I", struct.pack("<f", 10.0))[0]
+        header = struct.pack(
+            _WEIGHT_HDR_FMT,
+            _WEIGHT_MAGIC,
+            2,
+            102,
+            2,
+            1,
+            128,
+            128,
+            0,
+            1,
+            1,
+            1,
+            0,
+            bits,
+            131072,
+            65536,
+            0,
+            0,
+            0,
+            4096,
+        )
+        good = header + bytes(4096 + 131072 + 65536 - len(header))
+        wrong_version = bytearray(good)
+        struct.pack_into("<I", wrong_version, 4, 1)
+        wrong_limit = bytearray(good)
+        struct.pack_into("<f", wrong_limit, 48, 1.0)
+        try:
+            for data in (good[:4096], wrong_version, wrong_limit):
+                with self.subTest(bytes=len(data)):
+                    path.write_bytes(data)
+                    seq = engine.cpu_client_send_request(
+                        self.handle, 4, [102, 2, 1, 128, 128, 0, 1 << 32, bits]
+                    )
+                    self.assertGreaterEqual(
+                        engine.cpu_client_wait_completion(self.handle, seq, 10000000), 0
+                    )
+                    self.assertEqual(
+                        engine.cpu_client_slot_info(self.handle)["error_code"], -40
+                    )
+        finally:
+            path.unlink()
+
+    def test_legacy_fp8_entry(self):
+        remote = self.remote(103)
+        gate = torch.zeros(2, 256, 128, dtype=torch.float8_e4m3fn)
+        down = torch.zeros(2, 128, 128, dtype=torch.float8_e4m3fn)
+        gs, ds = torch.ones(2, 2, 1), torch.ones(2, 1, 1)
+        remote.set_weights(
+            gate.data_ptr(), down.data_ptr(), gs.data_ptr(), ds.data_ptr(), 0, 1, 0
+        )
+        output = self.forward(remote, torch.ones(32, 128, dtype=torch.bfloat16))
+        self.assertTrue(torch.equal(output, torch.zeros_like(output)))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_bf16_experts.py b/tests/test_bf16_experts.py
new file mode 100644
index 0000000..fbda4e3
--- /dev/null
+++ b/tests/test_bf16_experts.py
@@ -0,0 +1,102 @@
+"""原始 BF16 专家入口：限幅语义、路由加权以及旧入口兼容性。"""
+
+import unittest
+
+import torch
+import torch.nn.functional as F
+
+import moe_cpu_engine as engine
+
+
+def reference(hidden, w1, w2, weights, ids, limit):
+    """独立按专家计算；投影在 FP32 累加，激活和第二次投影按 BF16 落盘。"""
+    result = torch.zeros_like(hidden, dtype=torch.float32)
+    for expert in range(w1.shape[0]):
+        rows, slots = torch.where(ids == expert)
+        if rows.numel() == 0:
+            continue
+        gate, up = F.linear(hidden[rows].float(), w1[expert].float()).chunk(2, -1)
+        active = (F.silu(gate.clamp(max=limit)) * up.clamp(-limit, limit)).to(torch.bfloat16)
+        values = F.linear(active.float(), w2[expert].float()).to(torch.bfloat16)
+        result.index_add_(0, rows, values.float() * weights[rows, slots, None])
+    return result.to(torch.bfloat16)
+
+
+class Bf16ExpertsTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        torch.set_num_threads(4)
+
+    def test_clamp_direction_and_both_compute_paths(self):
+        size = 128
+        eye = torch.eye(size, dtype=torch.bfloat16)
+        # gate=输入，up=-输入，可区分 gate 仅截上界与错误的双向截断。
+        w1 = torch.cat([eye, -eye]).unsqueeze(0)
+        w2 = eye.unsqueeze(0)
+        for tokens in (1, 32):
+            for limit in (1.0, 10.0, float("inf")):
+                with self.subTest(tokens=tokens, limit=limit):
+                    hidden = torch.tensor([-20., -10., -2., 2., 10., 20., 0., 0.5], dtype=torch.bfloat16).repeat(tokens, 16)
+                    ids = torch.zeros(tokens, 1, dtype=torch.int32)
+                    weights = torch.ones(tokens, 1)
+                    actual = engine.fused_experts_bf16_cpu(hidden, w1, w2, weights, ids, limit)
+                    expected = reference(hidden, w1, w2, weights, ids, limit)
+                    torch.testing.assert_close(actual, expected, rtol=0.008, atol=1e-7)
+                    if limit == 10:
+                        unlimited = engine.fused_experts_cpu(hidden, w1, w2, weights, ids, False, False, False, None, None, None, None, None, False)
+                        self.assertGreater(float((unlimited - actual).abs().max()), 100)
+
+    def test_multiexpert_weighted_routes_and_padding(self):
+        generator = torch.Generator().manual_seed(47)
+        for tokens in (1, 64):
+            with self.subTest(tokens=tokens):
+                w1 = (torch.randn(4, 256, 128, generator=generator) * 0.1).to(torch.bfloat16)
+                w2 = (torch.randn(4, 128, 128, generator=generator) * 0.1).to(torch.bfloat16)
+                hidden = torch.randn(tokens, 128, generator=generator).to(torch.bfloat16)
+                ids = torch.randint(-1, 4, (tokens, 2), generator=generator, dtype=torch.int32)
+                weights = torch.rand(tokens, 2, generator=generator)
+                actual = engine.fused_experts_bf16_cpu(hidden, w1, w2, weights, ids, 1.0)
+                expected = reference(hidden, w1, w2, weights, ids, 1.0)
+                relative_l2 = (actual.float() - expected.float()).norm() / expected.float().norm().clamp_min(1e-9)
+                self.assertLess(float(relative_l2), 0.015)
+                self.assertTrue(bool(torch.isfinite(actual).all()))
+
+    def test_unlimited_entry_and_packed_weights_match_old_entry(self):
+        torch.manual_seed(17)
+        w1 = torch.randn(2, 256, 128).to(torch.bfloat16)
+        w2 = torch.randn(2, 128, 128).to(torch.bfloat16)
+        hidden = torch.randn(32, 128).to(torch.bfloat16)
+        ids = torch.randint(0, 2, (32, 2), dtype=torch.int32)
+        weights = torch.rand(32, 2)
+        old = engine.fused_experts_cpu(hidden, w1, w2, weights, ids, False, False, False, None, None, None, None, None, False)
+        for packed in (False, True):
+            a, b = (engine.convert_weight_packed(w1), engine.convert_weight_packed(w2)) if packed else (w1, w2)
+            actual = engine.fused_experts_bf16_cpu(hidden, a, b, weights, ids, float("inf"), packed)
+            self.assertTrue(torch.equal(actual, old))
+
+    def test_invalid_expert_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, "专家编号"):
+            engine.fused_experts_bf16_cpu(
+                torch.ones(1, 128, dtype=torch.bfloat16),
+                torch.ones(2, 256, 128, dtype=torch.bfloat16),
+                torch.ones(2, 128, 128, dtype=torch.bfloat16),
+                torch.ones(1, 1), torch.tensor([[2]], dtype=torch.int32), 10.,
+            )
+
+    def test_shape_mismatch_is_rejected_and_empty_input_is_supported(self):
+        w1 = torch.ones(2, 256, 128, dtype=torch.bfloat16)
+        w2 = torch.ones(2, 128, 128, dtype=torch.bfloat16)
+        with self.assertRaisesRegex(RuntimeError, "路由形状"):
+            engine.fused_experts_bf16_cpu(
+                torch.ones(2, 128, dtype=torch.bfloat16), w1, w2,
+                torch.ones(1, 1), torch.zeros(1, 1, dtype=torch.int32), 10.,
+            )
+        output = engine.fused_experts_bf16_cpu(
+            torch.empty(0, 128, dtype=torch.bfloat16), w1, w2,
+            torch.empty(0, 1), torch.empty(0, 1, dtype=torch.int32), 10.,
+        )
+        self.assertEqual(tuple(output.shape), (0, 128))
+
+
+if __name__ == "__main__":
+    unittest.main()
