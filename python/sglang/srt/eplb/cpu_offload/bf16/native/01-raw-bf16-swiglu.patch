+at::Tensor fused_experts_cpu(
+    at::Tensor& hidden_states, at::Tensor& w1, at::Tensor& w2,
+    at::Tensor& topk_weights, at::Tensor& topk_ids,
+    bool inplace, bool use_int8_w8a8, bool use_fp8_w8a16,
+    const std::optional<at::Tensor>& w1_scale,
+    const std::optional<at::Tensor>& w2_scale,
+    const std::optional<std::vector<int64_t>> block_size,
+    const std::optional<at::Tensor>& a1_scale,
+    const std::optional<at::Tensor>& a2_scale, bool is_vnni) {
+  return fused_experts_cpu_impl(hidden_states, w1, w2, topk_weights, topk_ids,
+      inplace, use_int8_w8a8, use_fp8_w8a16, w1_scale, w2_scale, block_size,
+      a1_scale, a2_scale, is_vnni, std::numeric_limits<float>::infinity());
+}
