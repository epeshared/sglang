@@ -0,0 +1,104 @@
+"""验证 BF16 上传的文件布局和错误应答，不依赖本机原生扩展。"""
+
+import importlib.util
+from pathlib import Path
+import struct
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import torch
+
+
+spec = importlib.util.spec_from_file_location(
+    "bf16_weight_protocol", Path(__file__).parents[1] / "ext/bf16_weight_protocol.py"
+)
+protocol = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(protocol)
+
+
+class ProtocolTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.remote = SimpleNamespace(
+            _cfg=SimpleNamespace(
+                layer_id=2,
+                expert_num=2,
+                hidden_size=32,
+                intermediate_size=32,
+                num_experts_per_tok=1,
+            ),
+            _handle=1,
+            _socket_id=0,
+            _slot_id=0,
+            _weights_loaded=False,
+            _shm_prefix=self.directory.name + "/test",
+        )
+        self.gate = torch.arange(4096).reshape(2, 64, 32).to(torch.bfloat16)
+        self.down = torch.ones(2, 32, 32, dtype=torch.bfloat16)
+        self.error = 0
+        self.sent = 0
+        engine = SimpleNamespace(
+            cpu_client_slot_info=lambda _: {"error_code": self.error, "done_seq": 7},
+            cpu_client_send_request=self.send,
+            cpu_client_wait_completion=lambda **_: 123,
+        )
+        self.fake = SimpleNamespace(
+            _engine=engine,
+            _WEIGHT_MAGIC=0x57454947,
+            _WEIGHT_HDR_FMT="<IIiiiiiiiiiiiQQQQQQ",
+        )
+
+    def send(self, handle, opcode, params):
+        self.sent += 1
+        self.assertEqual(opcode, 4)
+        self.assertEqual(params[7], struct.unpack("<I", struct.pack("<f", 10.0))[0])
+        data = Path(
+            self.remote._shm_prefix + ".socket0.slot0.layer2.weights"
+        ).read_bytes()
+        header = struct.unpack_from(self.fake._WEIGHT_HDR_FMT, data)
+        self.assertEqual(header[:4], (0x57454947, 2, 2, 2))
+        self.assertEqual(header[-6:], (8192, 4096, 0, 0, 0, 4096))
+        self.assertEqual(len(data), 16384)
+        self.assertEqual(
+            data[4096:12288], self.gate.view(torch.uint8).numpy().tobytes()
+        )
+        return 7
+
+    def upload(self, gate=None, limit=10.0):
+        with patch.dict(sys.modules, {"cpu_offload_remote_moe": self.fake}):
+            protocol.upload(
+                self.remote, self.gate if gate is None else gate, self.down, limit
+            )
+
+    def test_wire_layout_and_source_released(self):
+        self.upload()
+        self.assertTrue(self.remote._weights_loaded)
+        self.assertFalse(list(Path(self.directory.name).iterdir()))
+
+    def test_daemon_error_is_not_success(self):
+        self.error = -40
+        with self.assertRaisesRegex(RuntimeError, "加载失败"):
+            self.upload()
+        self.assertFalse(self.remote._weights_loaded)
+        self.assertFalse(list(Path(self.directory.name).iterdir()))
+
+    def test_bad_tensor_rejected_before_write(self):
+        for value in (self.gate.float(), self.gate.transpose(1, 2), self.gate[:1]):
+            with self.subTest(shape=value.shape):
+                with self.assertRaises(ValueError):
+                    self.upload(gate=value)
+        self.assertEqual(self.sent, 0)
+
+    def test_bad_limit_rejected_before_write(self):
+        for limit in (-1.0, 0.0, float("inf"), float("nan")):
+            with self.assertRaises(ValueError):
+                self.upload(limit=limit)
+        self.assertEqual(self.sent, 0)
