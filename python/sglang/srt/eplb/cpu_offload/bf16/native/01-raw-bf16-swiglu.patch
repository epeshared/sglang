@@ -0,0 +1,93 @@
+"""经既有共享内存槽位上传原始 BF16；操作码 4 与权重协议 v2 配套。"""
+
+import ctypes
+import math
+import mmap
+import os
+import struct
+
+import torch
+
+
+def upload(remote, gate_up, down, swiglu_limit):
+    """仅接收有形状和精度信息的张量，防止指针大小误判导致越界读取。"""
+    from cpu_offload_remote_moe import _engine, _WEIGHT_HDR_FMT, _WEIGHT_MAGIC
+
+    if "error_code" not in _engine.cpu_client_slot_info(remote._handle):
+        raise RuntimeError("客户端扩展版本过旧，无法检查守护进程错误码")
+    cfg = remote._cfg
+    e, h, i = cfg.expert_num, cfg.hidden_size, cfg.intermediate_size
+    if min(e, h, i) <= 0 or max(e, h, i) > 65536 or h % 32 or i % 32:
+        raise ValueError("BF16 层尺寸非法")
+    if not 0 < cfg.num_experts_per_tok <= e or cfg.layer_id < 0:
+        raise ValueError("BF16 层编号或 top-k 非法")
+    for tensor, shape in ((gate_up, (e, 2 * i, h)), (down, (e, h, i))):
+        if (
+            tensor.device.type != "cpu"
+            or tensor.dtype != torch.bfloat16
+            or not tensor.is_contiguous()
+            or tuple(tensor.shape) != shape
+        ):
+            raise ValueError("必须提供形状匹配的连续 CPU BF16 权重")
+    bits = struct.unpack("<I", struct.pack("<f", swiglu_limit))[0]
+    limit = struct.unpack("<f", struct.pack("<I", bits))[0]
+    if not math.isfinite(limit) or limit <= 0:
+        raise ValueError("BF16 限幅必须为有限正数")
+    if remote._weights_loaded:
+        raise RuntimeError("此客户端已经加载权重")
+    sizes = [gate_up.numel() * 2, down.numel() * 2]
+    total = 4096 + sum(sizes)
+    path = (
+        f"{remote._shm_prefix}.socket{remote._socket_id}"
+        f".slot{remote._slot_id}.layer{cfg.layer_id}.weights"
+    )
+    space = os.statvfs(os.path.dirname(path))
+    if total > space.f_bavail * space.f_frsize:
+        raise RuntimeError("共享内存剩余空间不足以传输 BF16 权重")
+    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        os.ftruncate(fd, total)
+        with mmap.mmap(fd, total) as mm:
+            header = struct.pack(
+                _WEIGHT_HDR_FMT,
+                _WEIGHT_MAGIC,
+                2,
+                cfg.layer_id,
+                e,
+                cfg.num_experts_per_tok,
+                h,
+                i,
+                0,
+                1,
+                1,
+                1,
+                0,
+                bits,
+                *sizes,
+                0,
+                0,
+                0,
+                4096,
+            )
+            mm[: len(header)] = header
+            address = ctypes.addressof(ctypes.c_char.from_buffer(mm))
+            offset = 4096
+            for tensor, size in zip((gate_up, down), sizes):
+                ctypes.memmove(address + offset, tensor.data_ptr(), size)
+                offset += size
+            mm.flush()
+        params = [cfg.layer_id, e, cfg.num_experts_per_tok, h, i, 0, 1 << 32, bits]
+        seq = _engine.cpu_client_send_request(
+            handle=remote._handle, opcode=4, params=params
+        )
+        result = _engine.cpu_client_wait_completion(
+            handle=remote._handle, expected_seq=seq, timeout_us=120_000_000
+        )
+        info = _engine.cpu_client_slot_info(remote._handle)
+        if result < 0 or info["error_code"] != 0 or info["done_seq"] != seq:
+            raise RuntimeError("BF16 权重加载失败：检查守护进程版本、层编号及协议")
+        remote._weights_loaded = True
+    finally:
+        os.close(fd)
+        # v2 在应答前已经完成打包，服务端不再持有原始映射。
+        os.unlink(path)
