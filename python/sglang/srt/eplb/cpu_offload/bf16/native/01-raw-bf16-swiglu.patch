+// Hy4 的 gate 只截上界，up 截到 [-limit, limit]；无限限值保留旧计算路径。
+template <typename Vec>
+inline void clamp_swiglu(Vec& gate, Vec& up, float limit) {
+  if (std::isfinite(limit)) {
+    gate = at::vec::minimum(gate, Vec(limit));
+    up = at::vec::maximum(at::vec::minimum(up, Vec(limit)), Vec(-limit));
+  }
+}
